{
  "name": "@toon-protocol/core",
  "version": "3.6.1",
  "description": "The TOON codec, NIP-34, base58 and the kind 5094 blob storage request builder and parser",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nip34": {
      "types": "./dist/nip34/index.d.ts",
      "import": "./dist/nip34/index.js"
    },
    "./toon": {
      "types": "./dist/toon/index.d.ts",
      "import": "./dist/toon/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nostr",
    "toon",
    "nip34",
    "base58"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toon-protocol/toon.git",
    "directory": "packages/core"
  },
  "author": "ALLiDoizCode",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@toon-format/toon": "^1.1.0",
    "nostr-tools": "^2.20.0",
    "simple-git": "^3.32.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
